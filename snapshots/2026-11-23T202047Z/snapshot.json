  "definitions": {
    "record_unit": "Stored notice record after import filtering and duplicate suppression; not a verified unique procurement. Source records, updates and lots can overlap.",
    "first_imported_last_seven_days": "First insertion into Contract Alerts during the inclusive UTC window, not buyer publication time. This launch batch includes earlier publications.",
    "active_future_deadline_notice_records": "Stored active-status records with a parseable response deadline strictly after the snapshot time. Not real-time confirmation that bidding remains open.",
    "countries": "Distinct recognized ISO3 delivery-country assignments in each active future-deadline record. A cross-border notice can appear in multiple rows. National imports may use publishing market; confirm actual delivery locations.",
    "regions": "Distinct stored UK region codes for active future-deadline records, with buyer-address fallback and approximate postcode mapping. Other countries generally have no UK region.",
    "cpv_divisions": "Distinct recognized two-digit CPV prefixes per active future-deadline record; overlapping groups using simplified labels.",
    "feed_last_checked_utc": "Last completed importer checkpoint, not completeness certification or independent crawl receipt.",
    "latest_import_failed": "Boolean from the last import status, also shown on the public coverage page. No error details are exported."
  },
  "rights_note": "These are Contract Alerts aggregate counts, not a redistribution of full tender notices or documents. Public sources remain subject to their own terms. UK notice information uses the Open Government Licence where applicable; TED data is copyright European Union. Source links identify provenance."
